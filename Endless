-- 自動觸發Prompt功能
local autoPrompt = false
local promptConnection = nil
local autoPromptBtn = createButton("自動觸發Prompt: 關", 4, CommonButtonsScroll, 40)
local isTriggering = false
local isContinuousMode = false
local lastClickTime = 0
local doubleClickThreshold = 0.5 -- 雙擊判定時間(秒)

autoPromptBtn.MouseButton1Click:Connect(function()
    local currentTime = tick()
    local timeSinceLastClick = currentTime - lastClickTime
    
    -- 如果在連續觸發模式中,點擊一次即可解除
    if isContinuousMode then
        -- 解除連續觸發模式
        isContinuousMode = false
        autoPrompt = false
        isTriggering = false
        
        if promptConnection then
            promptConnection:Disconnect()
            promptConnection = nil
        end
        
        autoPromptBtn.Text = "自動觸發Prompt: 關"
        lastClickTime = 0
        return
    end
    
    -- 檢測雙擊
    if timeSinceLastClick <= doubleClickThreshold and timeSinceLastClick > 0 then
        -- 雙擊 - 進入連續觸發模式
        isContinuousMode = true
        autoPrompt = true
        isTriggering = true
        autoPromptBtn.Text = "自動觸發Prompt: 連續觸發中"
        lastClickTime = 0
        
        -- 連續觸發循環
        task.spawn(function()
            while isContinuousMode do
                pcall(function()
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        
                        for _, prompt in pairs(workspace:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                                local promptParent = prompt.Parent
                                if promptParent then
                                    local distance = (hrp.Position - promptParent.Position).Magnitude
                                    if distance <= prompt.MaxActivationDistance then
                                        fireproximityprompt(prompt)
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5) -- 每0.5秒觸發一次
            end
        end)
        
        return
    end
    
    -- 單擊 - 一次性觸發模式
    if isTriggering then
        return
    end
    
    lastClickTime = currentTime
    
    -- 使用task.spawn避免阻塞雙擊檢測
    task.spawn(function()
        autoPrompt = true
        isTriggering = true
        autoPromptBtn.Text = "自動觸發Prompt: 開"
        
        -- 開始觸發Prompt
        promptConnection = game:GetService("RunService").Heartbeat:Connect(function()
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    
                    for _, prompt in pairs(workspace:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                            local promptParent = prompt.Parent
                            if promptParent then
                                local distance = (hrp.Position - promptParent.Position).Magnitude
                                if distance <= prompt.MaxActivationDistance then
                                    fireproximityprompt(prompt)
                                end
                            end
                        end
                    end
                end
            end)
        end)
        
        -- 顯示"已觸發"
        task.wait()
        autoPromptBtn.Text = "自動觸發Prompt: 已觸發"
        
        -- 1秒後自動關閉(只在非連續模式下執行)
        task.wait(1)
        
        -- 檢查是否進入了連續模式,如果是則不關閉
        if not isContinuousMode then
            -- 斷開連接
            if promptConnection then
                promptConnection:Disconnect()
                promptConnection = nil
            end
            
            -- 重置狀態
            autoPrompt = false
            isTriggering = false
            autoPromptBtn.Text = "自動觸發Prompt: 關"
        end
    end)
end)

